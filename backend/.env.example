# Polling System Backend Configuration

# Server
PORT=8080
ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=polling_system

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=supersecretjwtkey_change_in_production_min32bytes!
JWT_EXPIRE_HOURS=72

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
