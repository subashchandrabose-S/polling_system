# Voting System Frontend — Environment Configuration Example
# Copy this file to .env and fill in your values.

# Backend API URL
# For local development:
VITE_API_URL=http://localhost:8080
# For production:
# VITE_API_URL=https://your-backend-service.up.railway.app

# Public frontend origin used for copied links and QR codes.
# Set this to your deployed Vercel/Netlify URL so local development never leaks localhost into shared links.
VITE_PUBLIC_URL=https://your-frontend-app.vercel.app

# Optional explicit WebSocket origin. When omitted, the API origin is used.
# VITE_WS_URL=wss://your-backend-service.up.railway.app
